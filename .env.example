PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/garage-sale

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# SMTP (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Email branding
FROM_EMAIL=noreply@garagesale.com
FROM_NAME=Garage Sale

# CORS — comma-separated allowed origins (admin panel, Expo web on 8081/19006)
CLIENT_URL=http://localhost:5173,http://localhost:8081,http://localhost:19006

# Upload
MAX_FILE_SIZE=5242880

# Cloudinary — get from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Maps — used for reverse-geocoding admin-picked map coordinates
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Firebase Cloud Messaging (FCM) Push Notifications
# Option 1: Path to Firebase Service Account JSON file (recommended)
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./firebase-service-account.json
# Option 2: Full JSON string in environment variable
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"garagesale-cc0e7"}
# Option 3: Individual credentials
FIREBASE_PROJECT_ID=garagesale-cc0e7
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@garagesale-cc0e7.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="BOa7Nb50JjxgQ_dB7hI9rztHpWmv0nVblRHq7YEclk3Kqz5HCEtVX_qPH8Fqq1LfXhszF5S5DnkIMdD2jL_ulcA"
